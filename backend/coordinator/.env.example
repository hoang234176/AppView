# Local Coordinator listener. On Render, set PORT instead when no custom
# COORDINATOR_HTTP_ADDR is required; the service binds 0.0.0.0:<PORT>.
COORDINATOR_HTTP_ADDR=:8090
COORDINATOR_WORKER_WS_PATH=/ws/workers
COORDINATOR_HEARTBEAT_TIMEOUT=30s
COORDINATOR_HEARTBEAT_CHECK_INTERVAL=5s
COORDINATOR_DEFAULT_MAX_ATTEMPTS=2
