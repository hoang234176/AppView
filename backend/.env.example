# ==============================================================================
# THUỘC TÍNH DÙNG CHUNG (SHARED CONFIGURATION)
# ==============================================================================
LOG_LEVEL=INFO

# Test URLs (Dùng kiểm thử trích xuất và tải xuống mạng xã hội trong môi trường dev)
TEST_YOUTUBE_URL="https://youtu.be/example"
TEST_FACEBOOK_URL="https://www.facebook.com/share/example"
TEST_TIKTOK_URL="https://vt.tiktok.com/example"
TEST_INSTAGRAM_URL="https://www.instagram.com/p/example"

# ==============================================================================
# BACKEND COORDINATOR (DEPLOY / CLOUD)
# Service Go điều phối trung tâm (quản lý phân việc cho worker, WebSocket /ws/workers,
# broadcast invalidation event /ws/events, API /api/v1/download).
# Khi deploy lên Cloud:
# - PORT: Port được nền tảng cloud (Render/Fly/Railway/VPS) tự động cấp.
# - COORDINATOR_HTTP_ADDR: Gán địa chỉ/port lắng nghe (mặc định :8090 nếu local).
# - COORDINATOR_CORS_ORIGINS: Danh sách origin frontend (Web/Mobile) được phép gọi.
# ==============================================================================
COORDINATOR_HTTP_ADDR=:8090
COORDINATOR_WORKER_WS_PATH=/ws/workers
COORDINATOR_HEARTBEAT_TIMEOUT=30s
COORDINATOR_HEARTBEAT_CHECK_INTERVAL=5s
COORDINATOR_DEFAULT_MAX_ATTEMPTS=2
COORDINATOR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# BACKEND DOWNLOAD (DEPLOY / CLOUD)
# Service Python giải mã liên kết mạng xã hội (YouTube, TikTok, Facebook, Instagram).
# Khi deploy lên Cloud:
# - DOWNLOAD_COORDINATOR_WS_URL: Dán URL WebSocket của backend Coordinator đã deploy
#   (Ví dụ: wss://coordinator.yourdomain.com/ws/workers)
# - DOWNLOAD_COORDINATOR_WORKER_ID: Định danh worker Download kết nối đến Coordinator.
# - PYTHON_DOWNLOAD_PORT: Port lắng nghe của service Download nếu chạy HTTP (mặc định 5002).
# ==============================================================================
PYTHON_DOWNLOAD_HOST=0.0.0.0
PYTHON_DOWNLOAD_PORT=5002
DOWNLOAD_COORDINATOR_WS_URL=ws://localhost:8090/ws/workers
DOWNLOAD_COORDINATOR_WORKER_ID=download-worker-local

# ==============================================================================
# BACKEND STORAGE (LOCAL / CHẠY TRÊN MÁY CỤC BỘ CỦA NGƯỜI DÙNG)
# Service Go quản lý ổ đĩa lưu trữ, tải file trực tiếp và cookie lưu tại máy cục bộ.
# Nền tảng này LUÔN CHẠY LOCAL, KHÔNG DEPLOY lên Cloud.
# - STORAGE_COORDINATOR_WS_URL: Khi Coordinator deploy lên Cloud, dán link WebSocket
#   của Coordinator vào đây để Storage local kết nối ra Cloud nhận việc tải file
#   (Ví dụ: wss://coordinator.yourdomain.com/ws/workers)
# - STORAGE_COORDINATOR_WORKER_ID: Định danh worker Storage trên máy cục bộ.
# - APPVIEW_STATE_DIR: Thư mục lưu trạng thái và cookies cục bộ (mặc định ~/.tmp-appview).
# ==============================================================================
STORAGE_COORDINATOR_WS_URL=ws://localhost:8090/ws/workers
STORAGE_COORDINATOR_WORKER_ID=storage-local
# APPVIEW_STATE_DIR=
