# Outbound Coordinator worker configuration. Process environment values take
# precedence over this optional local file.
COORDINATOR_WS_URL=ws://localhost:8090/ws/workers
COORDINATOR_WORKER_ID=storage-local
# Optional local durable state/workspace root. Defaults to ~/.tmp-appview.
# APPVIEW_STATE_DIR=/Volumes/SSD/AppViewState
LOG_LEVEL=INFO
