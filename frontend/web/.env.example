# ==============================================================================
# FRONTEND WEB CONFIGURATION (.env.example)
# Public Vite configuration. Do not place real secrets in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COORDINATOR SERVICE (Cổng kết nối trung tâm - Quản lý download & settings)
# ------------------------------------------------------------------------------
# Khi chạy Local:
VITE_COORDINATOR_API_BASE_URL=http://localhost:8090/api/v1

# Khi Deploy lên Cloud/VPS, đổi thành link public của Coordinator:
# VITE_COORDINATOR_API_BASE_URL=https://coordinator.yourdomain.com/api/v1


# ------------------------------------------------------------------------------
# 2. STORAGE SERVICE (Chạy Local trên máy tính)
# ------------------------------------------------------------------------------
VITE_STORAGE_API_BASE_URL=http://localhost:8080/api/v1


# ------------------------------------------------------------------------------
# 3. DOWNLOAD SERVICE (Legacy direct paths / fallback)
# ------------------------------------------------------------------------------
VITE_DOWNLOAD_API_BASE_URL=http://localhost:5002/api/v1/download
VITE_DOWNLOAD_WS_URL=ws://localhost:5002/api/v1/download/ws
